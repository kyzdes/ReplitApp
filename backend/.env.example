# Server Configuration
PORT=3000
NODE_ENV=development
HOST=0.0.0.0

# CORS
CORS_ORIGIN=http://localhost:5173

# AI Providers (Optional - configure what you need)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_AI_API_KEY=
MISTRAL_API_KEY=

# Ollama (local)
OLLAMA_BASE_URL=http://localhost:11434

# JWT
JWT_SECRET=your-secret-key-change-in-production
JWT_EXPIRES_IN=7d

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX_REQUESTS=100

# Execution Limits
MAX_EXECUTION_TIME_MS=30000
MAX_MEMORY_MB=512
MAX_CPU_SHARES=1024

# File Upload
MAX_FILE_SIZE_MB=10
UPLOAD_DIR=./uploads

# Database (Optional - for persistence)
DATABASE_URL=

# Redis (Optional - for caching and sessions)
REDIS_URL=

# S3 Storage (Optional)
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
